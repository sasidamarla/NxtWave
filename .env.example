# Copy this file to ".env" for local development. Never commit ".env".
# On Vercel, add the same names under Project -> Settings -> Environment Variables.

# --- AI scoring (Google Gemini; server only: no VITE_ prefix, so it never reaches the browser) ---
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash. Check the exact name in Google AI Studio.
GEMINI_MODEL=gemini-2.5-flash
# Optional FALLBACK provider, used only if Gemini is busy or failing. Leave blank to skip.
# Get a key from the provider's own site (console.groq.com). Never use shared/"free key" sites.
GROQ_API_KEY=
# Optional. Check the exact name on Groq's models page.
GROQ_MODEL=llama-3.3-70b-versatile
# Set to 1 to use a fake rule-based scorer (no API key needed). Handy for UI work.
MOCK_AI=1

# --- Event rules the server enforces (see shared/event.js) ---
# Set to 1 to keep accepting registrations after the deadline (demos/testing). Leave unset for the real event.
OPEN_REGISTRATION=

# --- Storage (Google Sheet via Apps Script, see docs/apps-script.gs) ---
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=

# --- Optional: absolute site URL for share-image tags (Vercel fills this in automatically) ---
VITE_SITE_URL=
